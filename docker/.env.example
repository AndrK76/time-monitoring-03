# Local development environment for docker/docker-compose.yml.
#
# These values are development defaults. The per-service database roles
# (PG_AUTH_USER, PG_MONITORING_USER, PG_ADMIN_USER) are created by
# postgres/01-init.sh, and each service connects as the role that owns its
# schema, so a service cannot read another service's tables.
#
# JWT_SECRET and STORE_XOR are not here: they are process environment
# variables, set per service, and must be identical across all three. See
# back-go/MIGRATION.md.

PG_DB=mon3
PG_USER=mon3
PG_PASSWORD=mon3
PG_PORT=5432
PG_DATA_PATH=/var/lib/postgresql/data/pgdata

PG_AUTH_USER=mon3_auth
PG_AUTH_PASSWORD=mon3_auth
PG_AUTH_SCHEMA=auth

PG_MONITORING_USER=mon3_mon
PG_MONITORING_PASSWORD=mon3_mon
PG_MONITORING_SCHEMA=mon

PG_ADMIN_USER=mon3_admin
PG_ADMIN_PASSWORD=mon3_admin
PG_ADMIN_SCHEMA=admin

RABBIT_USER=mon3
RABBIT_PASSWORD=mon3
RABBIT_PORT=5672
RABBIT_WEB_PORT=15672
RABBIT_DATA_PATH=/var/lib/rabbitmq
