{
  "info": {
    "name": "Monitoring3 API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth Service",
      "item": [
        {
          "name": "Login as superadmin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"superadmin\",\n    \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/v1/auth/login",
              "host": ["{{auth_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/v1/auth/login",
              "host": ["{{auth_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Admin Service - Public",
      "item": [
        {
          "name": "Public endpoint (no auth)",
          "request": {
            "method": "GET",
            "header": [],
