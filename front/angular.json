{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "mon-test": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/mon-test",
      "sourceRoot": "projects/mon-test/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/mon-test",
            "index": "projects/mon-test/src/index.html",
            "browser": "projects/mon-test/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/mon-test/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/mon-test/src/favicon.ico",
              "projects/mon-test/src/assets"
            ],
            "styles": [
              "projects/mon-test/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "tsconfig.json",
                  "with": "tsconfig.prod.json"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/mon-test/src/environments/environment.ts",
                  "with": "projects/mon-test/src/environments/environment.development.ts"
                }
              ]
            },
            "prod": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "tsconfig.json",
                  "with": "tsconfig.prod.json"
                },
                {
                  "replace": "projects/mon-test/src/environments/environment.ts",
                  "with": "projects/mon-test/src/environments/environment.prod.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "host": "crm.host",
            "port": 4301
          },
          "configurations": {
            "production": {
              "buildTarget": "mon-test:build:production"
            },
            "development": {
              "buildTarget": "mon-test:build:development"
            },
            "prod": {
              "buildTarget": "mon-test:build:prod"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "mon-test:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/mon-test/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/mon-test/src/favicon.ico",
              "projects/mon-test/src/assets"
            ],
            "styles": [
              "projects/mon-test/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "admin-test": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/admin-test",
      "sourceRoot": "projects/admin-test/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/admin-test",
            "index": "projects/admin-test/src/index.html",
            "browser": "projects/admin-test/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/admin-test/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/admin-test/src/favicon.ico",
              "projects/admin-test/src/assets"
            ],
            "styles": [
              "projects/admin-test/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "8kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "tsconfig.json",
                  "with": "tsconfig.prod.json"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/admin-test/src/environments/environment.ts",
                  "with": "projects/admin-test/src/environments/environment.development.ts"
                }
              ]
            },
            "prod": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kb",
                  "maximumError": "8kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "tsconfig.json",
                  "with": "tsconfig.prod.json"
                },
                {
                  "replace": "projects/admin-test/src/environments/environment.ts",
                  "with": "projects/admin-test/src/environments/environment.prod.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "host": "admin.crm.host",
            "port": 4302
          },
          "configurations": {
            "production": {
              "buildTarget": "admin-test:build:production"
            },
            "development": {
              "buildTarget": "admin-test:build:development"
            },
            "prod": {
              "buildTarget": "admin-test:build:prod"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "admin-test:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/admin-test/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/admin-test/src/favicon.ico",
              "projects/admin-test/src/assets"
            ],
            "styles": [
              "projects/admin-test/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "shared-test": {
      "projectType": "library",
      "root": "projects/shared-test",
      "sourceRoot": "projects/shared-test/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/shared-test/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/shared-test/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared-test/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/shared-test/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}